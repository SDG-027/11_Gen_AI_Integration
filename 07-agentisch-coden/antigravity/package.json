{
  "name": "express-ts-api",
  "version": "1.0.0",
  "description": "Express 5 API with TypeScript 6, Mongoose, and Zod",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.0.0",
    "mongoose": "^8.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
