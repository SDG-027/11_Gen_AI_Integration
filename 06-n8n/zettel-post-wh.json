      "parameters": {
        "jsCode": "// Die Daten kommen aus dem Body des Webhooks\nconst formData = $input.first().json.body; \nconst updatedArray = [];\nconst receiptId = formData.receipt_id; // Das versteckte Feld von vorhin!\n\nlet i = 0;\n// Wir loopen so lange, bis wir eine Nummer finden, die es nicht mehr gibt\nwhile (formData[`item_${i}`] !== undefined) {\n    updatedArray.push({\n        item: formData[`item_${i}`],\n        // Wir machen aus dem Text-Preis wieder eine echte Zahl:\n        cost: parseFloat(formData[`cost_${i}`]), \n        category: formData[`category_${i}`],\n        interpretation: formData[`interpretation_${i}`]\n    });\n    i++;\n}\n\n// Wir geben die ID und das reparierte Array weiter\nreturn { \n    receipt_id: receiptId, \n    data: updatedArray \n};"
      },
